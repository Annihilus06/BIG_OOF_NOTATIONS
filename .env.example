# GridWise AI Environment Configuration
PORT=8000
HOST=0.0.0.0

# Google Gemini API Key (Optional - Fallback rule-based parser active if omitted)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Supabase / PostgreSQL Connection (Optional - in-memory fallback enabled)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gridwise

# CORS Allowed Origins
CORS_ORIGINS=*
